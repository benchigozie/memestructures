generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String?        @unique
  email         String         @unique
  password      String
  accountType   AccountType?
  accountStatus AccountStatus  @default(ACTIVE)
  kycStatus     KycStatus      @default(UNVERIFIED)
  emailVerified Boolean        @default(false)
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  individualKyc IndividualKyc?
  supportTickets SupportTicket[]
  investments   Investment[]
  memberships   Membership[]
  notifications Notification[]
  position      Position[]
  wallet        Wallet?
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   Membership[]
  kyc       OrganizationKyc?
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model IndividualKyc {
  id               String   @id @default(cuid())
  userId           String   @unique
  firstName        String
  lastName         String
  email            String
  phone            String
  dob              DateTime
  gender           String
  idType           String
  idNumber         String
  idFrontPath      String?
  idBackPath       String?
  selfieWithIdPath String?
  country          String
  state            String
  city             String
  address          String
  residenceType    String
  residenceDocPath String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrganizationKyc {
  id             String                 @id @default(cuid())
  organizationId String                 @unique
  companyName    String
  status         KycStatus              @default(UNVERIFIED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  documents      OrganizationDocument[]
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
}

model OrganizationMember {
  id                 String          @id @default(cuid())
  kycId              String
  role               KycRole
  idType             String
  idNumber           String
  address            String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  idBackPath         String?
  idFrontPath        String?
  proofOfAddressPath String?
  proofOfAddressType String?
  fullName           String
  kyc                OrganizationKyc @relation(fields: [kycId], references: [id], onDelete: Cascade)
}

model OrganizationDocument {
  id        String                   @id @default(cuid())
  kycId     String
  type      OrganizationDocumentType
  createdAt DateTime                 @default(now())
  filePath  String
  updatedAt DateTime                 @updatedAt
  kyc       OrganizationKyc          @relation(fields: [kycId], references: [id], onDelete: Cascade)
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model Fund {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  minInvestment Float
  maxInvestment Float?
  isActive      Boolean      @default(true)
  investments   Investment[]
  positions     Position[]
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  fundId    String
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fund      Fund     @relation(fields: [fundId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fundId])
}

model WalletTransaction {
  id        String                @id @default(cuid())
  walletId  String
  type      WalletTransactionType
  intent    TransactionIntent
  amount    Float
  reference String?
  status    TransactionStatus     @default(PENDING)
  coin          String?
  network       String?
  walletAddress String?
  proofPath     String?
  investmentId String? @unique
  investment   Investment? @relation(fields: [investmentId], references: [id])
  createdAt DateTime              @default(now())
  wallet    Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Investment {
  id            String           @id @default(cuid())
  userId        String
  amount        Float
  fee           Float
  total         Float
  status        InvestmentStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  fundId        String
  method        InvestmentMethod
  walletTransaction WalletTransaction?
  fund          Fund             @relation(fields: [fundId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  link      String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

enum KycStatus {
  UNVERIFIED
  VERIFIED
  PENDING
  REJECTED
  UNCOMPLETED
}

enum AccountType {
  INDIVIDUAL
  ENTERPRISE
  ADMIN
  DEV
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum KycRole {
  UBO
  DIRECTOR
  OPERATOR
}

enum OrganizationDocumentType {
  CERTIFICATE_OF_INCORPORATION
  MEMORANDUM_OF_ASSOCIATION
  PROOF_OF_BUSINESS_ADDRESS
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  RETURN
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TransactionIntent {
  WALLET_FUNDING
  DIRECT_INVESTMENT
  WALLET_INVESTMENT
  WITHDRAWAL_REQUEST
}

enum InvestmentMethod {
  WALLET
  DIRECT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  INVESTMENT
  DEPOSIT
  WITHDRAWAL
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String

  subject     String
  category SupportCategory

  attachmentPath String?

  status      SupportTicketStatus @default(OPEN)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]


  @@index([userId])
  @@index([status])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCategory {
  INVESTMENT
  WITHDRAWAL
  KYC
  ACCOUNT
  TECHNICAL
  OTHER
}

model SupportMessage {
  id          String @id @default(cuid())

  ticketId    String
  senderId    String?

  senderType  MessageSender

  message     String

  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

enum MessageSender {
  USER
  ADMIN
}


