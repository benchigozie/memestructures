generator client {
  provider   = "prisma-client"
  output     = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

enum KycStatus {
  UNVERIFIED
  UNCOMPLETED
  VERIFIED
  PENDING
  REJECTED
}

enum AccountType {
  INDIVIDUAL
  ENTERPRISE
  ADMIN
  DEV
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Investment {
  id          String   @id @default(cuid())
  userId      String

  fundName    String
  amount      Float
  fee         Float
  total       Float

  coin        String
  network     String
  walletAddress String

  proofPath   String

  status      InvestmentStatus @default(PENDING)

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

 model User {
  id            String   @id @default(cuid())
  name          String
  username      String?   @unique
  email         String   @unique
  password      String
  accountStatus AccountStatus @default(ACTIVE)
  kycStatus     KycStatus @default(UNVERIFIED)
  emailVerified Boolean  @default(false)
  imageUrl      String?
  memberships   Membership[]
  investments Investment[]
  individualKyc IndividualKyc?
  accountType   AccountType?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Organization {
  id        String   @id @default(cuid())
  name      String

  members   Membership[]

  kyc       OrganizationKyc?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id],  onDelete: Cascade)

  @@unique([userId, organizationId])
}



model IndividualKyc {
  id        String   @id @default(cuid())
  userId    String   @unique

  firstName String
  lastName  String
  email     String
  phone     String

  dob       DateTime
  gender    String

  idType    String
  idNumber  String

  idFrontPath     String?
  idBackPath      String?
  selfieWithIdPath String?

  country   String
  state     String
  city      String
  address   String

  residenceType String
  residenceDocPath String?

  user      User @relation(fields: [userId], references: [id],  onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationKyc {
  id               String   @id @default(cuid())
  organizationId   String   @unique

  companyName      String

  status           KycStatus @default(UNVERIFIED)

  organization     Organization @relation(fields: [organizationId], references: [id],  onDelete: Cascade)

  members          OrganizationMember[]
  documents        OrganizationDocument[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum KycRole {
  UBO
  DIRECTOR
  OPERATOR
}

model OrganizationMember {
  id          String   @id @default(cuid())
  kycId       String
  role      KycRole

  fullName   String

  idType      String
  idNumber    String

  idFrontPath  String?
  idBackPath   String?

  address     String

  proofOfAddressType String?
  proofOfAddressPath String?

  kyc         OrganizationKyc @relation(fields: [kycId], references: [id],  onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationDocumentType {
  CERTIFICATE_OF_INCORPORATION
  MEMORANDUM_OF_ASSOCIATION
  PROOF_OF_BUSINESS_ADDRESS
}

model OrganizationDocument {
  id          String @id @default(cuid())
  kycId       String

  type        OrganizationDocumentType
  filePath     String

  kyc         OrganizationKyc @relation(fields: [kycId], references: [id],  onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

